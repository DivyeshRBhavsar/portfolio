# Get a free API key at https://resend.com after verifying your sending domain
# (or use their default onboarding@resend.dev sender for quick testing).
# Copy this file to .env.local and put your real key there. Never commit real keys.
RESEND_API_KEY=re_your_key_here

# Luffy's chatbot (see "Luffy's knowledge base" in the README). Placeholders only.
# Hugging Face token with the "Make calls to Inference Providers" permission.
HF_TOKEN=hf_your_token_here
# Optional: the chat model (default Qwen/Qwen3.5-9B).
HF_CHAT_MODEL=Qwen/Qwen3.5-9B
# Upstash Vector index (dimension 1024, cosine similarity).
UPSTASH_VECTOR_REST_URL=https://your-index.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_vector_token_here
# Upstash Redis (question limits and FAQ logging, Part 2).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here
# A long random secret mixed into IP hashes for the chatbot's daily caps (raw IPs are never stored).
LUFFY_HASH_SALT=a_long_random_string_here
