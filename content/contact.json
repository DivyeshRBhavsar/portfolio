{
  "_note": "The contact form. Field types: text, select, url, textarea, chips. An option is a plain string, or { id, label } (and \"service\" for freelance project types: an id from content/services.json, or null). replyTime and bookingLink: leave empty to hide them. subjectLabel and subjectFields make the email subject, e.g. \"💼 Job opportunity · AI Engineer · Acme\" (no subjectFields: the sender's name).",
  "replyTime": "",
  "bookingLink": "",
  "privacyNote": "I'll only use your details to reply to you.",
  "purposes": [
    {
      "id": "job",
      "subjectLabel": "Job opportunity",
      "subjectFields": ["role", "company"],
      "emoji": "💼",
      "label": "Job opportunity",
      "description": "A role you'd like to talk to Divyesh about",
      "messagePlaceholder": "Tell me a little about the role and the team.",
      "fields": [
        {
          "id": "role",
          "label": "Role type",
          "type": "chips",
          "required": true,
          "options": [
            { "id": "ai-engineer", "label": "AI Engineer" },
            { "id": "web", "label": "Web Developer" },
            { "id": "data-science", "label": "Data Scientist" },
            { "id": "software", "label": "Software Developer" },
            { "id": "other", "label": "Other" }
          ]
        },
        { "id": "company", "label": "Company", "type": "text", "required": true, "maxLength": 100, "placeholder": "e.g. Acme Inc." },
        { "id": "location", "label": "Location type", "type": "chips", "required": true, "options": ["On-site", "Hybrid", "Remote"] },
        { "id": "city", "label": "City", "type": "text", "required": false, "maxLength": 80, "placeholder": "e.g. Toronto" },
        { "id": "employment", "label": "Employment type", "type": "chips", "required": true, "options": ["Full-time", "Contract", "Part-time"] },
        { "id": "posting", "label": "Job posting link", "type": "url", "required": false, "placeholder": "https://" },
        { "id": "hiringTimeline", "label": "Hiring timeline", "type": "select", "required": false, "options": ["ASAP", "Within a month", "1–3 months", "Just exploring"] }
      ]
    },
    {
      "id": "freelance",
      "subjectLabel": "Freelance",
      "subjectFields": ["projectType"],
      "emoji": "🛠️",
      "label": "Freelance or project work",
      "description": "Something you'd like built, fixed or automated",
      "messagePlaceholder": "Anything else Divyesh should know: your business, your data, deadlines.",
      "fields": [
        {
          "id": "projectType",
          "label": "Project type",
          "type": "chips",
          "required": true,
          "options": [
            { "id": "ai-assistant", "label": "AI assistant", "service": "ai-assistants" },
            { "id": "dashboard", "label": "Dashboard or reports", "service": "dashboards" },
            { "id": "predictive-model", "label": "Predictive model", "service": "predictions" },
            { "id": "automation", "label": "Automation or data extraction", "service": "automation" },
            { "id": "website", "label": "Website", "service": "websites" },
            { "id": "custom-tool", "label": "Custom tool", "service": "custom-tools" },
            { "id": "other", "label": "Other", "service": null }
          ]
        },
        { "id": "description", "label": "Short description", "type": "textarea", "required": true, "maxLength": 1000, "placeholder": "What would you like to fix or build?" },
        { "id": "timeline", "label": "Timeline", "type": "select", "required": true, "options": ["ASAP", "Within a month", "Flexible"] },
        { "id": "budget", "label": "Budget range", "type": "select", "required": false, "options": ["Under $1k", "$1k–5k", "$5k+", "Not sure yet"] }
      ]
    },
    {
      "id": "collaboration",
      "subjectLabel": "Collaboration",
      "subjectFields": ["kind"],
      "emoji": "🤝",
      "label": "Collaboration",
      "description": "Open source, research, writing or speaking",
      "messagePlaceholder": "What do you have in mind?",
      "fields": [
        { "id": "kind", "label": "Kind of collaboration", "type": "chips", "required": true, "options": ["Open source", "Research", "Content or writing", "Speaking", "Other"] },
        { "id": "link", "label": "Link", "type": "url", "required": false, "placeholder": "https://" }
      ]
    },
    {
      "id": "question",
      "subjectLabel": "Question",
      "subjectFields": ["about"],
      "emoji": "💬",
      "label": "Question about a project or post",
      "description": "Curious how something works?",
      "messagePlaceholder": "What would you like to know?",
      "fields": [
        { "id": "about", "label": "Which project or post?", "type": "select", "required": true, "source": "stories-and-posts" }
      ]
    },
    {
      "id": "hello",
      "subjectLabel": "Hello",
      "subjectFields": [],
      "emoji": "👋",
      "label": "Just saying hi",
      "description": "No reason needed",
      "messagePlaceholder": "Say hello! What brought you here?",
      "fields": []
    }
  ]
}
